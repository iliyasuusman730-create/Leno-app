        android:pathData="M 100,18 A 82,82 0 1,1 99.9,18 Z" />

    <!-- 3. Bold Crisp White Speech Bubble Outline with Bottom-Right Tail (#FFFFFF) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
