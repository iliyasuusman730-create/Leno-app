        android:fillColor="#000000"
        android:pathData="M 100,44 A 52,52 0 1,0 138,128 L 148,148 L 126,140 A 52,52 0 0,0 100,44 Z" />

    <!-- 4. Dimensionally Faceted 4-Pointed Sparkle Star (Left Facet - Bright Mint/Neon #00FF7F) -->
    <path
        android:fillColor="#00FF7F"
        android:pathData="M 100,64 C 100,96 100,96 68,96 C 100,96 100,96 100,128 Z" />

    <!-- 5. Dimensionally Faceted 4-Pointed Sparkle Star (Right Facet - Emerald #00B359) -->
    <path
        android:fillColor="#00B359"
        android:pathData="M 100,64 C 100,96 100,96 132,96 C 100,96 100,96 100,128 Z" />

    <!-- 6. Brilliant Sparkle Core Center Highlight (#B9F6CA) -->
